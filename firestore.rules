rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'TEACHER' ||
        request.auth.token.role == 'FACULTY' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'xp', 'level', 'coins'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // ROLES COLLECTION (Read-only for users, write for admin)
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CLASSROOMS COLLECTION
    match /classrooms/{classId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();

      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher();
      }

      match /notes/{noteId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher();
      }

      match /projects/{projectId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isOwner(resource.data.user_id) || isTeacher();
      }
    }

    // PROBLEMS COLLECTION (Published problems public to all users, archived to teachers/admins)
    match /problems/{problemId} {
      allow read: if isAuthenticated() && (resource.data.status == 'published' || isTeacher());
      allow write: if isAdmin();
    }

    // TEST CASES COLLECTION (Hidden test cases strictly protected from non-teachers!)
    match /testCases/{testCaseId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.is_hidden == false);
      allow write: if isAdmin();
    }

    // SUBMISSIONS COLLECTION (Users can read their own submissions)
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isTeacher());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // LEADERBOARD COLLECTION (Read-only)
    match /leaderboard/{entryDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // DEFAULT DENY FOR UNMATCHED PATHS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

